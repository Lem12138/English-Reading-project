generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())

  words     SavedWord[]
  sentences SavedSentence[]
  histories ReadingHistory[]
  favorites Favorite[]
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String
  url         String   @unique
  source      String
  category    String   @default("general")
  author      String?
  imageUrl    String?
  summary     String?
  outline     String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  words     SavedWord[]
  sentences SavedSentence[]
  histories ReadingHistory[]
  favorites Favorite[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model SavedWord {
  id           Int      @id @default(autoincrement())
  userId       Int
  word         String
  phonetic     String?
  translation  String
  enDefinition String?
  context      String?
  articleId    Int?
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model SavedSentence {
  id          Int      @id @default(autoincrement())
  userId      Int
  sentence    String
  translation String?
  articleId   Int?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model ReadingHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}
